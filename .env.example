# Energy Dashboard — local secrets and site configuration
# Copy to .env and fill in your values:  cp .env.example .env
# Never commit .env (it is gitignored).

# --- Growatt cloud ---
GROWATT_USER=
GROWATT_PASSWORD=
# Optional Open API token (recommended over password login)
GROWATT_API_TOKEN=

# --- Octopus Energy ---
OCTOPUS_API_KEY=
OCTOPUS_ACCOUNT=
OCTOPUS_IMPORT_MPAN=
OCTOPUS_IMPORT_SERIAL=
OCTOPUS_EXPORT_MPAN=
OCTOPUS_EXPORT_SERIAL=

# --- Solar forecast defaults (Parameters / Forecasts tabs) ---
FORECAST_LAT=51.5
FORECAST_LON=-0.1
FORECAST_TILT=35
FORECAST_AZIMUTH=0
FORECAST_KWP=6.0

# --- Tasmota IP scan range ---
TASMOTA_IP_START=222.20.20.101
TASMOTA_IP_END=222.20.20.112

# --- Optional: what3words map picker ---
W3W_API_KEY=

# --- Optional: PostgreSQL defaults for install scripts ---
# PG_HOST=localhost
# PG_PORT=5432
# PG_DB=powermon
# PG_USER=
# PG_PASSWORD=
