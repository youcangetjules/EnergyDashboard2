# Copy to /etc/default/powermon-broker (install script does this automatically).
# All variables are optional; see powermon_broker.py for defaults.

# PostgreSQL (must match Setup & Info → Database)
POWERMON_PG_HOST=localhost
POWERMON_PG_PORT=5432
POWERMON_PG_DB=powermon
POWERMON_PG_USER=
POWERMON_PG_PASSWORD=

# Tasmota IP scan range (must match Tasmota tab)
POWERMON_IP_START=222.20.20.101
POWERMON_IP_END=222.20.20.112

# Poll every N seconds; HTTP API for dashboard GUI
POWERMON_POLL_INTERVAL=30
POWERMON_LISTEN=127.0.0.1:8765

# Optional: override venv python path
# POWERMON_PYTHON=/home/user/PowerModel/octopus-ui/bin/python
