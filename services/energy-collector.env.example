# /etc/default/energy-collector — created by install-energy-collector.sh
# Edit and: sudo systemctl restart energy-collector

# PostgreSQL (match Setup & Info → Database)
POWERMON_PG_HOST=222.20.20.239
POWERMON_PG_PORT=5432
POWERMON_PG_DB=powermon
POWERMON_PG_USER=user
POWERMON_PG_PASSWORD=

# Tasmota — leave POWERMON_TASMOTA_IPS empty to scan ip_start..ip_end (Tasmota tab range).
POWERMON_TASMOTA_IPS=
POWERMON_IP_START=222.20.20.101
POWERMON_IP_END=222.20.20.114
# Or pin explicit devices: POWERMON_TASMOTA_IPS=222.20.20.101,222.20.20.102

POWERMON_TASMOTA_INTERVAL=30
POWERMON_GROWATT_INTERVAL=60
POWERMON_GROWATT_CHART_INTERVAL=900
POWERMON_LOOP_INTERVAL=5
POWERMON_LISTEN=127.0.0.1:8765

# Growatt cloud — use token (recommended) or username/password
POWERMON_GROWATT_TOKEN=
POWERMON_GROWATT_USER=
POWERMON_GROWATT_PASSWORD=
POWERMON_GROWATT_SERVER=https://server.growatt.com

# POWERMON_PYTHON=/home/user/PowerModel/octopus-ui/bin/python
